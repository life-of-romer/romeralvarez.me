---
interface Props {
  /** Shown in the address bar, without the protocol. */
  url: string;
  class?: string;
}

const { url, class: className } = Astro.props;
const host = url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<!-- A plain browser window around a project: the same dark frame the case studies use. -->
<div class:list={["browser", className]}>
  <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{host}</span></div>
  <div class="screen"><slot /></div>
</div>

<style>
  .browser {
    padding: 10px;
    border-radius: 14px;
    background: var(--ink);
    box-shadow: 0 30px 60px -28px rgb(17 19 24 / 0.45);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 6px 10px;
    font: 500 11px/1 var(--mono);
  }
  .bar i {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: #3a3e46;
  }
  .bar span {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 6px;
    border-radius: 6px;
    background: #22252b;
    color: #b6bac2;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .screen {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: #0d0f0c;
  }
</style>
