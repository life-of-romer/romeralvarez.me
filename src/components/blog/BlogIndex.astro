---
import Base from "../../layouts/Base.astro";
import { locales, t, type Locale } from "../../i18n";
import { blogIndexUrl, formatDate, getPostsFor, postLocale, postUrl } from "../../lib/blog";

interface Props {
  locale: Locale;
}

// Every post, in this language when translated and in Spanish otherwise (tagged with its language).
const { locale } = Astro.props;
const posts = await getPostsFor(locale);
const alternates = Object.fromEntries(locales.map((l) => [l, blogIndexUrl(l)]));
---


<Base locale={locale} title="Blog · Romer Alvarez" description={t(locale, "blog.lead")} alternates={alternates}>
  <main id="main" class="wrap flowing">
    <span class="label">{t(locale, "blog.title")}</span>
    <h1>{t(locale, "blog.title")}</h1>
    <p class="lead">{t(locale, "blog.lead")}</p>
    <ol class="posts">
      {
        posts.map((post) => (
          <li>
            <a href={postUrl(post)} hreflang={postLocale(post) === locale ? undefined : postLocale(post)}>
              <span class="meta">
                <time class="label" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
                {postLocale(post) !== locale && <span class="lang">{postLocale(post).toUpperCase()}</span>}
              </span>
              <h2 lang={postLocale(post)}>{post.data.title}</h2>
              <p lang={postLocale(post)}>{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

<style>
  main {
    padding-block: 72px 96px;
  }
  h1 {
    margin-top: 16px;
  }
  .lead {
    margin: 24px 0 56px;
    max-width: 40ch;
    font: 400 clamp(20px, 2.2vw, 26px)/1.35 var(--sans);
    color: var(--ink-muted);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .posts a {
    display: block;
    padding: 24px;
    background: var(--surface);
    border-radius: 16px;
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }
  .posts a:hover {
    transform: translateY(-3px);
  }
  .posts a:hover h2 {
    color: var(--pipeline-ink);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.08em;
    background: var(--pipeline-soft);
    color: var(--pipeline-ink);
    padding: 5px 7px;
    border-radius: 6px;
  }
  .posts h2 {
    margin: 10px 0 8px;
    font: 500 clamp(24px, 2.6vw, 32px)/1.15 var(--display);
    letter-spacing: -0.02em;
  }
  .posts p {
    margin: 0;
    color: var(--ink-muted);
    max-width: 70ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
