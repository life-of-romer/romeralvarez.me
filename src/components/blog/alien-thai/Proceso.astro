---
import "./alien-thai.css";
import "./proceso.css";
---

<!--
  The <Etapa> children scroll past a pinned wireframe of the site. Each stage drops its block
  into the page; the "pintar" stage turns the wireframe into Alien Thai's colours and words.
-->
<section class="x wide proceso">
  <div class="etapas">
    <slot />
  </div>
  <div class="pin">
    <div class="page" data-pintado="false" aria-hidden="true">
      <div class="blk nav" data-b="nav">
        <span class="burger"></span>
        <span class="l t logo"><span class="w">Alien Thai</span></span>
        <span class="p cta"></span>
      </div>
      <div class="blk hero" data-b="hero">
        <span class="im fill"></span>
        <i class="c disc a"></i>
        <div class="col over">
          <span class="l t"><span class="w">Un mundo</span></span>
          <span class="l t m"><span class="w">aparte<i>.</i></span></span>
          <div class="row btns"><span class="p a"></span><span class="p"></span></div>
        </div>
      </div>
      <div class="blk clases" data-b="clases">
        <span class="l t m"><span class="w">Tres artes, un mundo</span></span>
        <div class="row three">
          <span class="im f1"></span><span class="im f1"></span><span class="im f1"></span>
        </div>
      </div>
      <div class="blk precios" data-b="precios">
        <span class="l t s"><span class="w">Elige tu asalto<i>.</i></span></span>
        <div class="row three">
          <div class="col f1 card"><span class="num"><span class="w">40</span></span><span class="l"></span></div>
          <div class="col f1 card a"><span class="num"><span class="w">60</span></span><span class="l"></span></div>
          <div class="col f1 card"><span class="num"><span class="w">75</span></span><span class="l"></span></div>
        </div>
      </div>
      <div class="blk historia" data-b="historia">
        <div class="col f1 list">
          {
            ["๑", "๒", "๓", "๔"].map((n) => (
              <div class="row">
                <span class="nn"><span class="w">{n}</span></span>
                <span class="l f1" />
              </div>
            ))
          }
        </div>
        <div class="f1 quote">
          <span class="im fill"></span>
          <span class="l t"><span class="w">Salir de la oscuridad<i>.</i></span></span>
        </div>
      </div>
      <div class="blk cierre" data-b="cierre">
        <span class="im map"></span>
        <span class="word"><span class="w">Alien Thai</span></span>
      </div>
    </div>
    <div class="modo" role="group" aria-label="Ver el boceto">
      <button type="button" data-p="false" aria-pressed="true">Esqueleto</button>
      <button type="button" data-p="true" aria-pressed="false">Pintada</button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".proceso").forEach((root) => {
    root.classList.add("js");
    const page = root.querySelector<HTMLElement>(".page")!;
    const blocks = [...page.querySelectorAll<HTMLElement>(".blk")];
    const etapas = [...root.querySelectorAll<HTMLElement>(".etapa")];
    const modo = [...root.querySelectorAll<HTMLButtonElement>(".modo button")];

    const pintar = (on: boolean) => {
      page.dataset.pintado = String(on);
      modo.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.p === String(on))));
    };
    const ir = (i: number) => {
      etapas.forEach((e, j) => (e.dataset.estado = j < i ? "hecha" : j === i ? "on" : "antes"));
      const hechas = new Set(etapas.slice(0, i + 1).map((e) => e.dataset.seccion));
      blocks.forEach((b) => b.classList.toggle("in", hechas.has(b.dataset.b)));
      pintar(hechas.has("pintar"));
    };

    modo.forEach((b) => b.addEventListener("click", () => pintar(b.dataset.p === "true")));
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) ir(etapas.indexOf(e.target as HTMLElement));
        }),
      { rootMargin: "-45% 0px -45% 0px" },
    );
    etapas.forEach((e) => io.observe(e));
  });
</script>

<style>
  .proceso {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
  }
  .etapas {
    display: grid;
    gap: 30vh;
    padding-block: 14vh 42vh;
  }
  .js .etapas :global(.etapa[data-estado="antes"]),
  .js .etapas :global(.etapa[data-estado="hecha"]) {
    opacity: 0.4;
  }
  .pin {
    position: sticky;
    top: 88px;
    align-self: start;
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  /* The page being assembled. */
  .page {
    display: grid;
    grid-template-rows: 26px 2.3fr 1.25fr 1.2fr 1.3fr 1.35fr;
    gap: 8px;
    width: 100%;
    height: min(calc(100vh - 170px), 660px);
    min-height: 460px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    transition:
      background-color 0.7s var(--ease),
      border-color 0.7s var(--ease);
  }
  .blk {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 0;
    overflow: hidden;
    border-radius: 6px;
    transition:
      outline-color 0.5s var(--ease),
      background-color 0.5s var(--ease);
  }
  .blk > * {
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
  }
  /* Empty slot until its stage arrives. */
  .js .blk:not(.in) {
    outline: 1px dashed var(--line-strong);
    outline-offset: -1px;
  }
  .js .blk:not(.in) > * {
    opacity: 0;
    transform: translateY(14px);
  }

  .fill {
    position: absolute;
    inset: 0;
  }
  .nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-inline: 4px;
  }
  .burger {
    width: 16px;
    height: 8px;
    border-block: 2px solid var(--sk-strong);
  }
  .nav .logo {
    width: 30%;
  }
  .nav .cta {
    width: 18%;
    height: 12px;
  }
  .hero .disc {
    position: absolute;
    right: 12%;
    top: 50%;
    width: 42%;
    translate: 0 -50%;
  }
  .over {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 46%;
    gap: 7px;
  }
  .over .l.t {
    height: 16px;
  }
  .btns {
    gap: 8px;
    margin-top: 4px;
  }
  .btns .p {
    width: 40%;
    height: 12px;
  }
  .clases,
  .precios {
    padding: 8px 4px 0;
  }
  .three {
    flex: 1;
    gap: 8px;
    align-items: stretch;
    min-height: 0;
  }
  .card {
    justify-content: flex-end;
    padding: 6px;
    border: 1px solid var(--sk);
    border-radius: 4px;
  }
  .card.a {
    border-color: transparent;
  }
  .num {
    display: block;
    width: 60%;
    height: 20px;
    border-radius: 3px;
    background: var(--sk-strong);
  }
  .historia {
    flex-direction: row;
    gap: 10px;
    padding: 6px 4px;
  }
  .list {
    justify-content: space-around;
  }
  .list .row {
    gap: 8px;
  }
  .nn {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--sk-strong);
  }
  .quote {
    position: relative;
    display: grid;
    place-items: center;
    padding: 10px;
  }
  .quote .l.t {
    position: relative;
    width: 80%;
    height: 14px;
  }
  .cierre {
    padding-top: 4px;
  }
  .map {
    flex: 1;
  }
  .word {
    display: grid;
    place-items: center;
    flex: none;
    height: 42%;
    border-radius: 3px;
    background: var(--sk-strong);
  }

  /* Words sit inside their bars, invisible until the page is painted. */
  .w {
    display: block;
    opacity: 0;
    white-space: nowrap;
    color: var(--at-wall);
    font: 800 13px/10px var(--at-display);
    text-transform: uppercase;
    transition: opacity 0.6s var(--ease);
  }
  .w i {
    font-style: normal;
    color: var(--at-green);
  }

  /* Painted: Alien Thai's surface, colours and type over the same structure. */
  .page[data-pintado="true"] {
    --sk: rgb(239 235 223 / 0.1);
    --sk-strong: rgb(239 235 223 / 0.24);
    --sk-line: rgb(239 235 223 / 0.12);
    border-color: var(--at-tatami);
    background: var(--at-tatami);
  }
  .page[data-pintado="true"] .w {
    opacity: 1;
  }
  .page[data-pintado="true"] .l.t,
  .page[data-pintado="true"] .num,
  .page[data-pintado="true"] .nn,
  .page[data-pintado="true"] .word {
    background: transparent;
  }
  .page[data-pintado="true"] .a {
    background: var(--at-green);
  }
  .page[data-pintado="true"] .p:not(.a) {
    border-color: var(--at-line);
  }
  .page[data-pintado="true"] .hero .disc {
    background: var(--at-orange);
    opacity: 0.85;
  }
  .page[data-pintado="true"] .card.a .w {
    color: var(--at-tatami);
  }
  .page[data-pintado="true"] .over .w {
    font-size: 24px;
    line-height: 16px;
  }
  .page[data-pintado="true"] .num .w {
    font-size: 24px;
    line-height: 20px;
  }
  .page[data-pintado="true"] .nn .w {
    font: 500 14px/14px var(--at-sans);
    color: var(--at-green);
  }
  .page[data-pintado="true"] .quote .l.t {
    height: auto;
  }
  .page[data-pintado="true"] .quote .w {
    font-size: 17px;
    line-height: 0.95;
    white-space: normal;
    text-wrap: balance;
    text-align: center;
  }
  .page[data-pintado="true"] .word .w {
    font-size: clamp(26px, 3.4vw, 46px);
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-align: center;
  }
  .page[data-pintado="true"] .nav .logo .w {
    font-size: 15px;
  }

  .modo {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .modo button {
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-muted);
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .modo button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--surface);
  }

  /* Phone: the boards scroll on their own and the finished page closes the section. */
  @media (max-width: 760px) {
    .proceso {
      grid-template-columns: 1fr;
    }
    .etapas {
      gap: 56px;
      padding: 0;
    }
    .js .etapas :global(.etapa[data-estado]) {
      opacity: 1;
    }
    .pin {
      position: relative;
      top: 0;
    }
    .page {
      height: 520px;
      min-height: 0;
    }
    .js .blk:not(.in) {
      outline: 0;
    }
    .js .blk:not(.in) > * {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .page,
    .blk,
    .blk > *,
    .w {
      transition: none;
    }
  }
</style>
