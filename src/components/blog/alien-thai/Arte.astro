---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  imagen: ImageMetadata;
  alt: string;
  nombre: string;
  detalle: string;
}

const { imagen, alt, nombre, detalle } = Astro.props;
---

<figure class="arte">
  <Image src={imagen} alt={alt} widths={[400, 800]} sizes="min(78vw, 520px)" />
  <figcaption>
    <span class="name">{nombre}</span>
    <span class="detail">{detalle}</span>
  </figcaption>
</figure>

<style>
  .arte {
    display: grid;
    gap: 12px;
    margin: 0;
    scroll-snap-align: start;
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    filter: grayscale(1);
    transition: filter 0.6s var(--ease);
  }
  .arte:hover img {
    filter: none;
  }
  figcaption {
    display: grid;
    gap: 6px;
  }
  .name {
    font: 800 2.2rem/0.9 var(--at-display);
    text-transform: uppercase;
  }
  .detail {
    font-size: 15px;
    color: var(--at-wall-dim);
  }
</style>
