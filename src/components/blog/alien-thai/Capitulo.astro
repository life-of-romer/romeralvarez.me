---
import { Image } from "astro:assets";
import "./alien-thai.css";
import n1 from "../../../assets/blog/alien-thai/numeral-1.avif";
import n2 from "../../../assets/blog/alien-thai/numeral-2.avif";
import n3 from "../../../assets/blog/alien-thai/numeral-3.avif";
import n4 from "../../../assets/blog/alien-thai/numeral-4.avif";

interface Props {
  n: 1 | 2 | 3 | 4;
  titulo: string;
}

const { n, titulo } = Astro.props;
const numeral = { 1: n1, 2: n2, 3: n3, 4: n4 }[n];
const thai = ["๑", "๒", "๓", "๔"][n - 1];
const words = ["uno", "dos", "tres", "cuatro"][n - 1];
---

<!-- Chapter opener: the Thai numeral from the gym's site, then the title. Text after it stays Markdown. -->
<div class="x at capitulo">
  <Image src={numeral} alt={`Numeral tailandés ${thai}`} width={120} />
  <div>
    <span class="at-meta">Capítulo {words}</span>
    <h3>{titulo}</h3>
  </div>
</div>

<style>
  .capitulo {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 3vw, 36px);
    margin: 56px 0 28px calc(var(--gutter) - var(--indent));
    max-width: calc(720px + var(--indent) - var(--gutter));
    padding: clamp(22px, 4vw, 40px);
    border-radius: 12px;
  }
  img {
    width: clamp(64px, 10vw, 120px);
    height: auto;
  }
  h3 {
    margin: 6px 0 0;
    font: 800 clamp(2rem, 4.6vw, 3.6rem) / 0.9 var(--at-display);
    text-transform: uppercase;
  }
</style>
