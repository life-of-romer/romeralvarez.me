---
import { Font, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "./alien-thai.css";

interface Props {
  imagen: ImageMetadata;
  alt: string;
  lugar: string;
  /** The last character is painted green, like the gym's own headlines. */
  titulo: string;
}

const { imagen, alt, lugar, titulo } = Astro.props;
const [head, last] = [titulo.slice(0, -1), titulo.slice(-1)];
---

<!-- The post opens here, so this component also loads Alien Thai's two faces. -->
<Font cssVariable="--font-at-display" />
<Font cssVariable="--font-at-sans" />

<section class="x at bleed portada" aria-label={titulo}>
  <Image src={imagen} alt={alt} widths={[640, 1280, 1920]} sizes="100vw" loading="eager" />
  <div class="in">
    <span class="at-meta">{lugar}</span>
    <h2 class="at-title">{head}<i>{last}</i></h2>
    <slot />
  </div>
</section>

<style>
  .portada {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(78vh, 720px);
    overflow: hidden;
  }
  .portada img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: open 1.6s var(--ease) both;
  }
  @keyframes open {
    from {
      clip-path: inset(22% 6% 22% 6%);
      transform: scale(1.06);
    }
    to {
      clip-path: inset(0);
      transform: none;
    }
  }
  .portada::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(15 16 10 / 0.9), rgb(15 16 10 / 0.35) 55%, rgb(15 16 10 / 0) 80%);
  }
  .in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 18px;
    max-width: 1100px;
    padding: clamp(28px, 6vw, 72px) var(--gutter);
    padding-left: var(--indent);
  }
  .in :global(p) {
    margin: 0;
    max-width: 40ch;
    font-size: 18px;
  }
  @media (prefers-reduced-motion: reduce) {
    .portada img {
      animation: none;
    }
  }
</style>
