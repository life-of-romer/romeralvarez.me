---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import "./alien-thai.css";

interface Props {
  imagen: ImageMetadata;
  cita: string;
  autor: string;
  web: string;
  instagram: string;
}

const { imagen, cita, autor, web, instagram } = Astro.props;
const bg = await getImage({ src: imagen, width: 1920, format: "webp" });
---

<!--
  One background layer that drifts slower than the page. The fuller idea (EXPLORATION):
  split the illustration into layers (map, wall, blue alien) moving at different speeds.
-->
<section class="x at bleed final" aria-label="Cierre">
  <div class="layer" style={`background-image:url(${bg.src})`}></div>
  <div class="shade"></div>
  <div class="in">
    <span class="at-meta">Dónde estamos</span>
    <blockquote>{cita}</blockquote>
    <span class="who">{autor}</span>
    <div class="ctas">
      <a class="at-pill green" href={web} target="_blank" rel="noopener">Ver la web</a>
      <a class="at-pill ghost" href={`https://www.instagram.com/${instagram.replace("@", "")}/`} target="_blank" rel="noopener">{instagram}</a>
    </div>
  </div>
</section>

<script>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".final .layer").forEach((layer) => {
      let raf = 0;
      addEventListener(
        "scroll",
        () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            const box = layer.parentElement!.getBoundingClientRect();
            const p = (innerHeight - box.top) / (innerHeight + box.height);
            if (p > -0.2 && p < 1.2) layer.style.transform = `translateY(${(p - 0.5) * -60}px)`;
          });
        },
        { passive: true },
      );
    });
  }
</script>

<style>
  .final {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 460px;
    overflow: hidden;
  }
  .layer {
    position: absolute;
    inset: -6%;
    background-size: cover;
    background-position: center;
    will-change: transform;
  }
  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(15 16 10 / 0.92), rgb(15 16 10 / 0.5));
  }
  .in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 18px;
    max-width: 1100px;
    padding: 64px var(--gutter) 64px var(--indent);
  }
  blockquote {
    margin: 0;
    max-width: 22ch;
    font: 800 clamp(1.9rem, 4vw, 3.2rem) / 0.98 var(--at-display);
    text-transform: uppercase;
  }
  .who {
    font: 500 12px/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-wall-dim);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
</style>
