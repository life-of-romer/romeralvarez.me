---
import Base from "../../../layouts/Base.astro";
import ProjectRow from "../../../components/projects/ProjectRow.astro";
import ProjectsEnd from "../../../components/projects/ProjectsEnd.astro";
import { getProjects } from "../../../lib/projects";

const projects = await getProjects();
const description = "Proyectos de Romer Alvarez: webs, productos y plataformas que puedes abrir y usar.";
---

<Base locale="es" title="Proyectos · Romer Alvarez" description={description} alternates={{ es: "/es/proyectos/" }} fallbacks={{ en: "/#projects", it: "/it/#projects" }}>
  <main id="main" class="wrap">
    <h1>Proyectos.</h1>
    <p class="lead">Cosas que he llevado de la idea a producción. Ábrelas, navégalas y mira con qué están hechas.</p>
    <ol class="list">
      {
        projects.map((project) => (
          <li>
            <ProjectRow project={project} locale="es" level={2} />
          </li>
        ))
      }
    </ol>
    <ProjectsEnd title="¿Tienes algo en mente?" text="Una web, un producto o la plataforma donde va a funcionar. Escríbeme y te respondo en 24 horas." />
  </main>
</Base>

<style>
  main {
    padding-block: 72px 0;
  }
  .lead {
    margin: 24px 0 72px;
    max-width: 38ch;
    font: 400 clamp(20px, 2.2vw, 26px)/1.35 var(--sans);
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 96px;
  }
</style>
