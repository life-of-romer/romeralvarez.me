---
// Variant C: the pieces hang from the pipeline line, one stop each, newest first.
import Base from "../../layouts/Base.astro";
import ProjectsEnd from "../../components/projects/ProjectsEnd.astro";
import Filter from "../../components/lab/Filter.astro";
import Visual from "../../components/lab/Visual.astro";
import { getPieces, kinds } from "../../components/lab/pieces";
import { t } from "../../i18n";
import "../../components/lab/lab.css";

const locale = "es";
const pieces = (await getPieces()).sort((a, b) => Number(b.year) - Number(a.year));
---

<Base locale={locale} title="Galería C · Romer Alvarez">
  <main id="main" class="wrap g-main">
    <h1>{t(locale, "projects.page.title")}</h1>
    <p class="g-lead">{t(locale, "projects.page.lead")}</p>
    <Filter pieces={pieces} />

    <ol class="stops">
      {
        pieces.map((piece) => (
          <li data-kind={piece.kind}>
            <a class="shot" href={piece.href} tabindex="-1" aria-hidden="true">
              <Visual piece={piece} sizes="(min-width: 1100px) 600px, 100vw" />
            </a>
            <div class="body">
              <p class="label g-meta">
                <span class="year">{piece.year}</span>
                <span>{kinds[piece.kind]}</span>
                <span>{piece.org}</span>
              </p>
              <h2 class="g-name">
                <a href={piece.href}>{piece.name}</a>
              </h2>
              <p class="g-summary">{piece.summary}</p>
              <p class="role">
                <span class="label">{t(locale, "projects.role")}</span> {piece.role}
              </p>
              <ul class="g-tags">
                {piece.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
    <ProjectsEnd locale={locale} title={t(locale, "projects.page.endTitle")} text={t(locale, "projects.page.endText")} />
  </main>
</Base>

<style>
  .stops {
    --rail: 4px;
    list-style: none;
    position: relative;
    margin: 64px 0 0;
    padding: 0 0 24px;
    display: grid;
    gap: 88px;
  }
  .stops::before {
    content: "";
    position: absolute;
    left: var(--rail);
    top: 6px;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--pipeline);
  }
  .stops > li {
    position: relative;
    display: grid;
    gap: 28px;
    padding-left: 32px;
  }
  /* The stop's node on the line. */
  .stops > li::before {
    content: "";
    position: absolute;
    left: var(--rail);
    top: 0;
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    border-radius: 50%;
    background: var(--pipeline);
    box-shadow: 0 0 0 5px var(--paper);
  }
  .shot {
    display: block;
    margin-top: 28px;
    transition: transform 0.5s var(--ease);
  }
  .shot:hover {
    transform: translateY(-4px);
  }
  .year {
    color: var(--pipeline-ink);
  }
  .g-name {
    margin: 12px 0 14px;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.08;
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 20px 0 18px;
    font-size: 15px;
  }
  @media (min-width: 1100px) {
    .stops {
      --rail: 50%;
      gap: 120px;
    }
    .stops > li {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 112px;
      align-items: center;
      padding-left: 0;
    }
    .stops > li::before {
      top: 50%;
      margin-top: -6.5px;
    }
    .shot {
      margin-top: 0;
    }
    /* Every other stop puts its window on the far side of the line. */
    .stops > li:nth-child(even) .shot {
      order: 2;
    }
  }
</style>
