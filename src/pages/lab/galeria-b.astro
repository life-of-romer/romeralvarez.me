---
// Variant B: a dense index; the row you point at shows its window or diagram beside the list.
import Base from "../../layouts/Base.astro";
import ProjectsEnd from "../../components/projects/ProjectsEnd.astro";
import Filter from "../../components/lab/Filter.astro";
import Visual from "../../components/lab/Visual.astro";
import { getPieces, kinds } from "../../components/lab/pieces";
import { t } from "../../i18n";
import "../../components/lab/lab.css";

const locale = "es";
const pieces = await getPieces();
---

<Base locale={locale} title="Galería B · Romer Alvarez">
  <main id="main" class="wrap g-main">
    <h1>{t(locale, "projects.page.title")}</h1>
    <p class="g-lead">{t(locale, "projects.page.lead")}</p>
    <Filter pieces={pieces} />

    <div class="index">
      <ol class="rows">
        {
          pieces.map((piece, i) => (
            <li data-kind={piece.kind} data-row={piece.id} class:list={{ on: i === 0 }}>
              <a href={piece.href}>
                <span class="label year">{piece.year}</span>
                <span class="main">
                  <span class="g-name">{piece.name}</span>
                  <span class="sub">
                    {piece.org} · {piece.role}
                  </span>
                </span>
                <span class="label kind">{kinds[piece.kind]}</span>
              </a>
              <div class="inline">
                <Visual piece={piece} sizes="100vw" />
              </div>
            </li>
          ))
        }
      </ol>
      <div class="pane" aria-hidden="true">
        {
          pieces.map((piece, i) => (
            <div class:list={["view", { on: i === 0 }]} data-view={piece.id}>
              <Visual piece={piece} />
              <p class="g-summary">{piece.summary}</p>
              <ul class="g-tags">
                {piece.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <ProjectsEnd locale={locale} title={t(locale, "projects.page.endTitle")} text={t(locale, "projects.page.endText")} />
  </main>
</Base>

<script>
  const rows = [...document.querySelectorAll<HTMLElement>("[data-row]")];
  const show = (row: HTMLElement) => {
    rows.forEach((r) => r.classList.toggle("on", r === row));
    document.querySelectorAll<HTMLElement>("[data-view]").forEach((v) => v.classList.toggle("on", v.dataset.view === row.dataset.row));
  };
  rows.forEach((row) => {
    row.addEventListener("pointerenter", () => show(row));
    row.addEventListener("focusin", () => show(row));
  });
  // After filtering, the first row left takes the pane.
  document.addEventListener("gallery:filter", () => {
    const first = rows.find((r) => !r.hidden);
    if (first) show(first);
  });
</script>

<style>
  .index {
    margin-top: 48px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .rows li {
    border-bottom: 1px solid var(--line);
  }
  .rows a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 26px 0;
    text-decoration: none;
  }
  .main {
    display: grid;
    gap: 8px;
  }
  .g-name {
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.1;
    transition: color 0.2s var(--ease);
  }
  .sub {
    color: var(--ink-muted);
    font-size: 15px;
  }
  .kind {
    padding: 7px 9px;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
  }
  .inline {
    padding-bottom: 32px;
  }
  .pane {
    display: none;
  }
  @media (min-width: 1100px) {
    .index {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 64px;
      align-items: start;
    }
    .inline {
      display: none;
    }
    .rows li.on .g-name {
      color: var(--pipeline-ink);
    }
    /* The orange node marks the row on show. */
    .rows a {
      position: relative;
    }
    .rows li.on a::before {
      content: "";
      position: absolute;
      left: -22px;
      top: 50%;
      width: 9px;
      height: 9px;
      margin-top: -4.5px;
      border-radius: 50%;
      background: var(--pipeline);
    }
    .pane {
      display: grid;
      position: sticky;
      top: 96px;
    }
    .view {
      grid-area: 1 / 1;
      display: grid;
      gap: 24px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition:
        opacity 0.35s var(--ease),
        transform 0.5s var(--ease),
        visibility 0s 0.35s;
    }
    .view.on {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .view {
      transition: none;
      transform: none;
    }
  }
</style>
